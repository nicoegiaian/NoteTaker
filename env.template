# ============================================================
#  CREDENCIALES — Renombrá este archivo a .env
#  NUNCA compartas este archivo ni lo subas a ningún lado
# ============================================================

# Tu API Key de Anthropic (anthropic.com → Get API Key)
ANTHROPIC_API_KEY=sk-ant-api03-REEMPLAZA-CON-TU-KEY

# Ruta a la carpeta donde Teams guarda las grabaciones
# Ejemplo Windows: C:\Users\TuNombre\OneDrive - Empresa\Grabaciones
# Ejemplo Mac:     /Users/TuNombre/Library/CloudStorage/OneDrive/Grabaciones
ONEDRIVE_RECORDINGS_PATH=C:\Users\TUNOMBRE\OneDrive - TUEMPRESA\Grabaciones de Teams

# Carpeta donde se guardarán las notas generadas (se crea automáticamente)
OUTPUT_FOLDER=C:\Users\TUNOMBRE\Desktop\NotasReuniones
